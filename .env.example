# Anthropic API key for the public resume chat + fit + (later) the engine matcher
ANTHROPIC_API_KEY=

# Neon Postgres connection string (set after provisioning the Neon project)
DATABASE_URL=

# Single password to access the private /engine dashboard
ENGINE_PASSWORD=

# Random 32+ char secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
ENGINE_SESSION_SECRET=
